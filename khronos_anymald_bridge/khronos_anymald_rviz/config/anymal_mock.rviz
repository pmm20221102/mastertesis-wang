Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Fixed Frame: map
      Plane Cell Count: 40
      Cell Size: 1.0
      Line Style: Lines
      Color: 160; 160; 164
      Alpha: 0.5
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Name: WaypointNodes
      Enabled: true
      Topic: /anymald/waypoints/nodes
      Queue Size: 10
      Value: true
    - Class: rviz_default_plugins/Marker
      Name: WaypointEdges
      Enabled: true
      Topic: /anymald/waypoints/edges
      Queue Size: 10
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Name: RoomAnchors
      Enabled: true
      Topic: /anymald/room_anchors
      Queue Size: 10
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Name: StretchEdges
      Enabled: true
      Topic: /anymald/waypoints/stretch_edges
      Queue Size: 10
      Value: true
    - Class: rviz_default_plugins/Path
      Name: Route
      Enabled: true
      Topic: /anymald/route
      Queue Size: 10
      Color: 0; 255; 102
      Value: true
    - Class: rviz_default_plugins/Marker
      Name: RouteMarker
      Enabled: true
      Topic: /anymald/route_marker
      Queue Size: 10
      Value: true
    - Class: rviz_default_plugins/Marker
      Name: GoalMarker
      Enabled: true
      Topic: /anymald/goal_marker
      Queue Size: 10
      Value: true
    - Class: rviz_default_plugins/Marker
      Name: MockRobot
      Enabled: true
      Topic: /anymald/mock_robot
      Queue Size: 10
      Value: true
    - Class: rviz_default_plugins/Marker
      Name: StartMarker
      Enabled: true
      Topic: /anymald/start_marker
      Queue Size: 10
      Value: true
    - Class: rviz_default_plugins/Marker
      Name: RobotTrail
      Enabled: true
      Topic: /anymald/robot_trail
      Queue Size: 10
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Name: Checkpoints
      Enabled: true
      Topic: /anymald/checkpoints
      Queue Size: 10
      Value: true
    - Class: rviz_default_plugins/Marker
      Name: GoalMarker
      Enabled: true
      Topic: /anymald/goal_marker
      Queue Size: 10
      Value: true
    - Class: rviz_default_plugins/Marker
      Name: KhronosMesh
      Enabled: true
      Topic: /anymald/khronos_mesh
      Queue Size: 10
      Value: true
  Global Options:
    Fixed Frame: map
    Background Color: 0; 0; 0
    Frame Rate: 30
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 48.0
      Focal Point:
        X: 0
        Y: 20
        Z: 0
      Name: Current View
      Pitch: 1.5707
      Yaw: 0.0
      Value: Orbit (rviz)
Window Geometry:
  Displays:
    collapsed: false
  Views:
    collapsed: false
  Height: 900
  Width: 1400
