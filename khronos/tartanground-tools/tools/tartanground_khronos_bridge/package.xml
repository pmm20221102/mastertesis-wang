<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>tartanground_khronos_bridge</name>
  <version>0.1.0</version>
  <description>
    TartanGround Hospital -> ROS2 bag -> Khronos minimal adaptation bridge.
    Converts TartanGround image/depth/seg/pose into a Khronos-consumable ROS2 bag.
  </description>
  <maintainer email="masterthesis@kit.edu">masterthesis</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>rosbag2_py</depend>
  <depend>sensor_msgs</depend>
  <depend>tf2_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>builtin_interfaces</depend>
  <depend>cv_bridge</depend>
  <depend>python3-numpy</depend>
  <depend>python3-yaml</depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
